# This folder is meant to be liftable into a repository of its own, so it
# carries the ignores it needs rather than relying on the one at the root of
# the repository it currently sits in.
.venv/
__pycache__/
*.pyc

# --log writes here
*.txt
!requirements.txt

# sign_key.txt is tracked as a template: two comment lines saying where to get
# a key, and an empty line to paste it on. The key itself is a secret, so on
# each machine it is pasted in locally and held back with
#     git update-index --skip-worktree sign_key.txt
# which makes git ignore edits to a file it tracks. See documents/tiktok.md.
!sign_key.txt
.env
