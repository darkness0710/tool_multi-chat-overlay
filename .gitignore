# This folder is meant to be liftable into a repository of its own, so it
# carries the ignores it needs rather than relying on the one at the root of
# the repository it currently sits in.
.venv/
__pycache__/
*.pyc

# --log writes here
*.txt
!requirements.txt

# debug.log and the one previous run kept beside it. Written every run, so it
# would otherwise show up dirty on every single `git status`.
*.log
*.log.1

# config.txt is tracked as a template: the three setting names with empty
# values, and comments saying where a sign key comes from. A filled-in copy
# holds a secret, so on each machine the edit is held back with
#     git update-index --skip-worktree config.txt
# which makes git ignore changes to a file it tracks. See documents/tiktok.md.
!config.txt
.env
